APP_ENV=dev
LOG_LEVEL=INFO
DEFAULT_CHANNEL=feishu

# Feishu app credentials
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Optional security fields
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Optional LLM backend settings
LLM_PROVIDER=openai_compatible
LLM_ACTIVE_MODEL=qwen
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
LLM_CHAT_PATH=/v1/chat/completions
LLM_TIMEOUT_SECONDS=60
LLM_SYSTEM_PROMPT=You are a helpful assistant.
# Optional: Multi-model routing. Runtime reads model entries from a TOML file.
# Example: LLM_MODELS_CONFIG_PATH=src/feishubot/ai/configs/model_routes.example.toml
LLM_MODELS_CONFIG_PATH=

# Optional override: Tool runtime config TOML path (enabled tools + routing timeout + terminal policy)
# Default is auto-loaded from tools.default.toml in repository root
# Example: AI_TOOLS_CONFIG_PATH=src/feishubot/ai/configs/tools.example.toml
AI_TOOLS_CONFIG_PATH=

# Feishu long-connection Agent backend
FEISHU_AGENT_BACKEND=qoder_sdk
QODER_PERSONAL_ACCESS_TOKEN=pt-xxx
QODER_WORKSPACE_ROOT=D:\workspace\projects\qoderwork\prod
QODER_MODEL=auto
QODER_SESSION_STORE_DIR=~/.feishubot/qoder-sessions
QODER_RUN_TIMEOUT_SECONDS=600
QODER_CANCEL_GRACE_SECONDS=5
QODER_SHUTDOWN_GRACE_SECONDS=30
QODER_MAX_CONCURRENT_RUNS=2
QODER_MAX_LIVE_SESSIONS=4
QODER_MAX_QUEUED_PER_SESSION=3
QODER_SESSION_IDLE_TTL_SECONDS=1800
QODER_DEDUP_TTL_SECONDS=86400
QODER_DOMAIN_KNOWLEDGE_DIR=~/.feishubot/domain-knowledge
# Seamless update (update-feishubot.cmd) coordinates old/new processes here; empty disables it.
QODER_HANDOFF_DIR=~/.feishubot/handoff
QODER_DIAGNOSIS_CARDS_ENABLED=true
QODER_DIAGNOSIS_STORE_DIR=~/.feishubot/diagnoses
